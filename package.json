{
  "name": "ansam-admin",
  "version": "1.0.0",
  "description": "منصة أنسام الإدارية - صيانة وتبريد وتكييف",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "cf:dev": "wrangler dev",
    "db:init": "wrangler d1 execute ansam-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute ansam-db --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute ansam-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute ansam-db --remote --file=./seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wrangler": "^4.114.0"
  }
}
